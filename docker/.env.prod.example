# NemakiWare production environment — copy to .env and fill in.
#   cp .env.prod.example .env && edit .env
#
# In the cloud, prefer injecting these from a secret store (AWS Secrets Manager
# / SSM Parameter Store, Azure Key Vault) rather than committing a .env file.
# The IaaS bootstrap scripts under deploy/ generate this file for you.

# ── Image coordinates (required) ─────────────────────────────────────────
# Where the published images live and which version to run.
NEMAKI_IMAGE_PREFIX=ghcr.io/aegif/nemakiware
NEMAKI_VERSION=3.2.0

# ── CouchDB credentials (required, no defaults) ──────────────────────────
# Use a strong, randomly-generated password in production.
COUCHDB_USER=admin
COUCHDB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── HTTP exposure ─────────────────────────────────────────────────────────
# Host interface the core's 8080 port binds to. Default 127.0.0.1 = only a
# local reverse proxy can reach it. Set 0.0.0.0 ONLY for a throwaway demo.
NEMAKI_HTTP_BIND=127.0.0.1
# How NemakiWare should regard the public scheme behind the proxy:
#   auto  — trust request.isSecure() (use with Tomcat RemoteIpValve)
#   https — always mark cookies Secure (recommended when fronted by TLS)
#   http  — dev only
NEMAKI_PUBLIC_SCHEME=auto

# ── JVM / memory tuning (optional) ───────────────────────────────────────
NEMAKI_HEAP_MIN=1g
NEMAKI_HEAP_MAX=3g
SOLR_HEAP=512m

# ── RAG / TEI (optional, --profile rag) ──────────────────────────────────
TEI_MEM_LIMIT=4g
TEI_MEM_RESERVE=2g

# ── Optional: secrets directory mounted read-only into the core ──────────
# Holds google-service-account.json, microsoft-entra.env, ingest-connectors.env.
# The bootstrap creates an empty ./secrets if you do not supply one.
NEMAKI_SECRETS_DIR=./secrets

# ── Optional auth / directory integrations (left disabled by default) ────
# Google direct OIDC
CLOUD_AUTH_GOOGLE_ENABLED=false
CLOUD_AUTH_GOOGLE_CLIENT_ID=
# Microsoft Entra ID
CLOUD_AUTH_MICROSOFT_ENABLED=false
CLOUD_AUTH_MICROSOFT_CLIENT_ID=
CLOUD_AUTH_MICROSOFT_TENANT_ID=
# Cloud Drive connectors
CLOUD_DRIVE_GOOGLE_ENABLED=false
CLOUD_DRIVE_MICROSOFT_ENABLED=false
# SSO toggles
SSO_OIDC_ENABLED=false
SSO_SAML_ENABLED=false
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
# LDAP directory sync
DIRECTORY_SYNC_ENABLED=false
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
