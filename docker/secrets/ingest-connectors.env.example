# NemakiWare External Connector secrets (template — copy to ingest-connectors.env).
#
# Each value is resolved at runtime by a connector's `credentialRef` key.
# Key -> env var mapping (PropertyManager.readValue: UPPERCASE, '.' -> '_'):
#   ingest.slack.sites.token   -> INGEST_SLACK_SITES_TOKEN   (Slack Bot Token  xoxb-...)
#   ingest.notion.sites.token  -> INGEST_NOTION_SITES_TOKEN  (Notion Integration Token secret_/ntn_...)
#   ingest.box.sites.token     -> INGEST_BOX_SITES_TOKEN     (Box OAuth2 access token)
#   ingest.dropbox.sites.token -> INGEST_DROPBOX_SITES_TOKEN (Dropbox OAuth2 access token)
#
# After editing, recreate the core container:
#   cd docker && docker compose -f docker-compose-simple.yml up -d --build --force-recreate core

INGEST_SLACK_SITES_TOKEN=
INGEST_NOTION_SITES_TOKEN=
INGEST_BOX_SITES_TOKEN=
INGEST_DROPBOX_SITES_TOKEN=
