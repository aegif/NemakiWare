# Cloud Authentication & Drive Integration - Environment Variables
# Copy this file to docker/.env.cloud and fill in your credentials.
# NEVER commit .env.cloud to version control.
#
# USAGE (docker-compose-prod.yml):
#   docker compose -f docker-compose-prod.yml --env-file .env.cloud up -d
#
# ONE file, TWO delivery mechanisms — the names differ on purpose:
#
#   [A] Compose-interpolated variables. CATALINA_OPTS in docker-compose-prod.yml
#       references them as ${CLOUD_AUTH_GOOGLE_CLIENT_ID:-} etc. and passes them
#       to the JVM as -D system properties. These only work via `--env-file`
#       (or host environment) — putting them in container env does nothing,
#       and the -D default would mask it anyway.
#
#   [B] Variables the application reads DIRECTLY from container environment
#       (PropertyManager: property key uppercased, dots -> underscores, no
#       prefix). docker-compose-prod.yml loads this file with `env_file:` too,
#       which is what delivers these. CATALINA_OPTS does not pass them as -D,
#       so nothing masks them.
#
# (3.3.0 correction: this file used to carry NEMAKI_*-prefixed names, which were
# read by nothing at all.)
#
# NOTE: cloud.auth.* / cloud.drive.* are admin-managed dynamic keys — a value
# saved by the admin UI / setup wizard (nemaki_conf) takes precedence over both
# mechanisms. cloud.directory.sync.* is not admin-managed.

# ─── [A] Compose-interpolated (feed CATALINA_OPTS -D) ────────────────────────

# Google OAuth / OIDC login
CLOUD_AUTH_GOOGLE_ENABLED=false
CLOUD_AUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Microsoft OAuth / OIDC login
CLOUD_AUTH_MICROSOFT_ENABLED=false
CLOUD_AUTH_MICROSOFT_CLIENT_ID=your-azure-app-client-id
CLOUD_AUTH_MICROSOFT_TENANT_ID=your-azure-tenant-id

# Cloud Drive browsing
CLOUD_DRIVE_GOOGLE_ENABLED=false
CLOUD_DRIVE_MICROSOFT_ENABLED=false

# ─── [B] Read directly from container env by the application ─────────────────

# Client secrets (not passed via CATALINA_OPTS; delivered as container env).
# The admin UI (nemaki_conf) is the recommended place for these — values saved
# there win over this file.
CLOUD_AUTH_GOOGLE_CLIENTSECRET=your-google-client-secret
CLOUD_AUTH_MICROSOFT_CLIENTSECRET=your-azure-client-secret

# Cloud Drive token encryption key (AES-256, 32 bytes base64-encoded)
# Generate with: openssl rand -base64 32
CLOUD_DRIVE_ENCRYPTION_KEY=

# Google Workspace directory sync (service account with domain-wide delegation)
CLOUD_DIRECTORY_SYNC_ENABLED=false
CLOUD_DIRECTORY_SYNC_PROVIDERS=google
CLOUD_DIRECTORY_SYNC_GOOGLE_SERVICEACCOUNTKEY=/usr/local/tomcat/secrets/google-service-account.json
CLOUD_DIRECTORY_SYNC_GOOGLE_DOMAIN=your-domain.com
CLOUD_DIRECTORY_SYNC_GOOGLE_ADMINEMAIL=admin@your-domain.com

# Microsoft Entra ID directory sync (app-only / client credentials)
CLOUD_DIRECTORY_SYNC_MICROSOFT_TENANTID=your-azure-tenant-id
CLOUD_DIRECTORY_SYNC_MICROSOFT_CLIENTID=your-azure-app-client-id
CLOUD_DIRECTORY_SYNC_MICROSOFT_CLIENTSECRET=your-azure-client-secret
