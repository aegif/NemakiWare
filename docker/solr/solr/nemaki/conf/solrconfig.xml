<!--
  NemakiWare Solr Configuration
  Based on Solr 9.x default template, trimmed to only settings NemakiWare uses.
  See https://solr.apache.org/guide/solr/latest/configuration-guide/configuring-solrconfig-xml.html
-->
<config>

  <luceneMatchVersion>9.11</luceneMatchVersion>

  <!-- Use classic schema.xml instead of managed schema -->
  <schemaFactory class="ClassicIndexSchemaFactory"/>

  <dataDir>${solr.data.dir:}</dataDir>

  <directoryFactory name="DirectoryFactory"
                    class="${solr.directoryFactory:solr.NRTCachingDirectoryFactory}"/>

  <codecFactory class="solr.SchemaCodecFactory"/>

  <!-- ================ Index Config ================ -->
  <indexConfig>
    <lockType>${solr.lock.type:native}</lockType>
  </indexConfig>

  <!-- ================ Update Handler ================ -->
  <updateHandler class="solr.DirectUpdateHandler2">

    <updateLog>
      <str name="dir">${solr.ulog.dir:}</str>
    </updateLog>

    <!-- Hard commit: flush to disk periodically -->
    <autoCommit>
      <maxTime>${solr.autoCommit.maxTime:15000}</maxTime>
      <openSearcher>false</openSearcher>
    </autoCommit>

    <!-- Soft commit: make changes visible for NRT search -->
    <autoSoftCommit>
      <maxTime>${solr.autoSoftCommit.maxTime:3000}</maxTime>
    </autoSoftCommit>

  </updateHandler>

  <!-- ================ Query ================ -->
  <query>

    <maxBooleanClauses>${solr.max.booleanClauses:1024}</maxBooleanClauses>

    <!-- Solr 9.x default cache implementation is CaffeineCache -->
    <filterCache size="512" initialSize="512" autowarmCount="0"/>
    <queryResultCache size="512" initialSize="512" autowarmCount="0"/>
    <documentCache size="512" initialSize="512" autowarmCount="0"/>

    <!-- Block Join cache (used by RAG parent-child documents) -->
    <cache name="perSegFilter"
           class="solr.CaffeineCache"
           size="10"
           initialSize="0"
           autowarmCount="10"
           regenerator="solr.NoOpRegenerator" />

    <enableLazyFieldLoading>true</enableLazyFieldLoading>

    <queryResultWindowSize>20</queryResultWindowSize>
    <queryResultMaxDocsCached>200</queryResultMaxDocsCached>

    <listener event="newSearcher" class="solr.QuerySenderListener">
      <arr name="queries"/>
    </listener>
    <listener event="firstSearcher" class="solr.QuerySenderListener">
      <arr name="queries"/>
    </listener>

    <useColdSearcher>false</useColdSearcher>

  </query>

  <!-- ================ Request Dispatcher ================ -->
  <requestDispatcher>
    <httpCaching never304="true" />
  </requestDispatcher>

  <!-- ================ Request Handlers ================ -->

  <!-- Default search handler -->
  <requestHandler name="/select" class="solr.SearchHandler">
    <lst name="defaults">
      <str name="echoParams">explicit</str>
      <int name="rows">10</int>
    </lst>
  </requestHandler>

  <!-- JSON search handler -->
  <requestHandler name="/query" class="solr.SearchHandler">
    <lst name="defaults">
      <str name="echoParams">explicit</str>
      <str name="wt">json</str>
      <str name="indent">true</str>
    </lst>
  </requestHandler>

  <!-- Default field for query/select -->
  <initParams path="/update/**,/query,/select">
    <lst name="defaults">
      <str name="df">_text_</str>
    </lst>
  </initParams>

  <!-- NemakiWare custom handler for init and index actions -->
  <requestHandler name="/nemaki" class="jp.aegif.nemaki.NemakiCoreAdminHandler" startup="lazy">
    <lst name="defaults">
      <str name="echoParams">explicit</str>
    </lst>
  </requestHandler>

</config>
