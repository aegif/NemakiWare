<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.springframework.org/schema/context"
	xmlns:mvc="http://www.springframework.org/schema/mvc"
	xsi:schemaLocation="
		http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
		http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd
		http://www.springframework.org/schema/mvc http://www.springframework.org/schema/mvc/spring-mvc.xsd">

	<!-- Enable Spring MVC configuration with default JSON converter -->
	<mvc:annotation-driven />

	<!-- Optional: Custom ObjectMapper configuration for JSON handling -->
	<!-- Uncomment and customize if needed:
	<bean id="jacksonObjectMapper" class="com.fasterxml.jackson.databind.ObjectMapper">
		<property name="serializationInclusion" value="NON_NULL"/>
	</bean>
	-->

	<!-- CORS is handled by SimpleCorsFilter (web.xml), not Spring MVC.
	     Configure via system property: api.cors.allowedOrigins (default: *) -->

	<!-- CSRF protection for state-changing Spring MVC endpoints -->
	<!-- Mirrors ResourceBase.validateCsrfProtection() used by Jersey resources -->
	<!-- Webhook receiver paths (/v1/ingest-webhook/{id}) are HMAC-verified and
	     exempted inside CsrfInterceptor, but /subscribe admin mutations are protected. -->
	<mvc:interceptors>
		<mvc:interceptor>
			<mvc:mapping path="/v1/**" />
			<bean class="jp.aegif.nemaki.rest.controller.CsrfInterceptor" />
		</mvc:interceptor>
	</mvc:interceptors>

	<!-- Component scanning for REST controllers only -->
	<!-- Purview @Service beans are in root context (serviceContext.xml) and visible to MVC via parent -->
	<context:component-scan base-package="jp.aegif.nemaki.rest.controller" />
	<context:component-scan base-package="jp.aegif.nemaki.rest.ingest" />

	<!-- Multipart resolver for file upload via /api/v1/repo/{repoId}/ingest -->
	<bean id="multipartResolver"
		  class="org.springframework.web.multipart.support.StandardServletMultipartResolver" />

	<!-- Exception handler for REST API -->
	<bean class="jp.aegif.nemaki.rest.controller.GlobalExceptionHandler" />

</beans>