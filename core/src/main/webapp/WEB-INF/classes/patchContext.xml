<?xml version="1.0" encoding="UTF-8"?>
<!-- This context file needs in another file: ContentService/PrincipalService/TypeService
	bean definition -->

<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:aop="http://www.springframework.org/schema/aop"
 xmlns:context="http://www.springframework.org/schema/context"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
    http://www.springframework.org/schema/aop http://www.springframework.org/schema/aop/spring-aop.xsd
    http://www.springframework.org/schema/util http://www.springframework.org/schema/util/spring-util.xsd
    http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">

    <context:annotation-config />
	<!-- Component scanning for jp.aegif.nemaki.patch intentionally disabled to prevent conflicts -->
	<!-- PatchService is registered as explicit bean definition below instead -->
	<!-- Component scanning for jp.aegif.nemaki.init intentionally disabled to prevent conflicts -->
	<!-- CMISPostInitializer is registered as explicit bean definition below instead -->

	<!--
		PHASE 3: PatchService - ApplicationListener via Explicit Bean Definition

		Similar to CMISPostInitializer, PatchService is registered as an explicit bean
		to ensure proper ApplicationListener registration in the child context.
		@Component scanning alone does not guarantee ApplicationListener registration
		in NemakiApplicationContextLoader's child context.

		Execution order managed by Spring's @Order(3) annotation in PatchService.java.

		BEAN ORDER TEST (2025-11-11): Moved PatchService BEFORE CMISPostInitializer to test
		if bean definition order affects ApplicationListener registration.
	-->
	<!--
		CRITICAL DISCOVERY (2025-11-10): Spring does not automatically create beans in child context
		unless they have properties or init-method. CMISPostInitializer works because it has
		cmisPatchList property. Adding init-method="initializeIfNeeded" to force bean creation.

		COMPLETE FIX: init-method forces bean instantiation, properties provide required dependencies

		EXPERIMENTAL FIX (2025-11-11): Temporarily removing init-method to test if it prevents
		ApplicationListener registration. Properties alone should be sufficient to force bean creation.
	-->
	<bean id="patchService" class="jp.aegif.nemaki.patch.PatchService">
		<property name="repositoryInfoMap"><ref bean="repositoryInfoMap" /></property>
		<property name="connectorPool"><ref bean="connectorPool" /></property>
		<property name="propertyManager"><ref bean="propertyManager" /></property>
		<property name="typeService"><ref bean="typeService" /></property>
		<property name="typeManager"><ref bean="TypeManager" /></property>
		<property name="contentService"><ref bean="ContentService" /></property>
		<property name="solrUtil"><ref bean="solrUtil" /></property>
		<!-- EXPERIMENTAL FIX (2025-11-11): Add List with INLINE bean to match CMISPostInitializer pattern -->
		<!-- CMISPostInitializer uses inline <bean class="..."> elements, not <ref bean="..."> -->
		<!-- Testing if inline bean definition is required for ApplicationListener registration -->
		<!-- NOTE: These patches will NOT be executed (apply() requires init-method or explicit call) -->
		<property name="patchList">
			<list>
				<!--
					RC4 (R4): Patch_StandardCmisViews was previously registered
					here AND in cmisPostInitializer.cmisPatchList. PatchHistory
					deduped execution per repository, but the startup log
					emitted "Applying patch: standard-cmis-views" twice and
					confused diagnostics. Removed here; the canonical home is
					cmisPostInitializer.cmisPatchList (Path A).
				-->
				<!-- Purview state views in nemaki_conf for dead-letter/state queries -->
				<bean class="jp.aegif.nemaki.patch.Patch_PurviewStateViews">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- Migrate Purview state from nemaki_conf to dedicated nemaki_purview_state DB -->
				<bean class="jp.aegif.nemaki.patch.Patch_PurviewStateMigration">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- NOTE: Patch_CloudDriveMetadataSecondaryType is registered in cmisPostInitializer's cmisPatchList -->
				<!-- DO NOT add it here to avoid duplicate execution -->
			</list>
		</property>
	</bean>

	<!--
		Phase 2: CMIS Post-Initializer (New Architecture)

		CRITICAL FIX: Changed from InitializingBean to ContextRefreshedEvent
		Uses @EventListener to execute CMIS operations AFTER entire Spring context
		is fully initialized, ensuring TypeManager and all services are operational.
		This prevents "TYPES is empty" errors during patch execution.

		BEAN ORDER TEST (2025-11-11): Moved AFTER PatchService to test if bean definition
		order affects ApplicationListener registration.
	-->
	<bean id="cmisPostInitializer" class="jp.aegif.nemaki.init.CMISPostInitializer">
		<property name="cmisPatchList">
			<list>
				<!-- CRITICAL: System folder must be created first for other patches to work -->
				<bean class="jp.aegif.nemaki.patch.Patch_SystemFolderSetup">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- Initial content setup: Sites, Technical Documents folders and CMIS spec PDF -->
				<!-- MUST run after SystemFolderSetup but before any caching initialization -->
				<bean class="jp.aegif.nemaki.patch.Patch_InitialContentSetup">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- CMIS-specific patches that require running services -->
				<bean class="jp.aegif.nemaki.patch.Patch_StandardCmisViews">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- Narrow userItemsById/groupItemsById views with objectType filter (3.1 upgrade) -->
				<!-- Separate from StandardCmisViews to ensure execution on existing environments -->
				<bean class="jp.aegif.nemaki.patch.Patch_NarrowUserGroupViews">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- Children view _count reduce for server-side pagination (3.1.0) -->
				<!-- Separate from StandardCmisViews to ensure execution on 2.4 upgrades -->
				<bean class="jp.aegif.nemaki.patch.Patch_ChildrenViewReduceCount">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- Initial users and groups: testgroup, testuser with firstName/lastName -->
				<!-- Enhanced version with proper user properties -->
				<bean class="jp.aegif.nemaki.patch.Patch_TestUserInitialization">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
			<!-- NemakiWare standard types: nemaki:document, secondary types -->
				<!-- MUST run after StandardCmisViews to ensure base types exist -->
				<bean class="jp.aegif.nemaki.patch.Patch_NemakiwareStandardTypes">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- Webhookable secondary type for webhook configuration on folders/documents -->
				<!-- MUST run after NemakiwareStandardTypes to ensure cmis:secondary base type exists -->
				<bean class="jp.aegif.nemaki.patch.Patch_WebhookableSecondaryType">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- Webhook delivery log views for Phase 3 DAO layer -->
				<!-- MUST run after StandardCmisViews to ensure design document exists -->
				<bean class="jp.aegif.nemaki.patch.Patch_WebhookDeliveryLogViews">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- Retention migration log views for retention job logging -->
				<bean class="jp.aegif.nemaki.patch.Patch_RetentionMigrationLogViews">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- Archive byCreator view for user-specific archive listing -->
				<bean class="jp.aegif.nemaki.patch.Patch_ArchiveByCreatorView">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- Archive byArchivedBy view for listing archives by the deleting user -->
				<bean class="jp.aegif.nemaki.patch.Patch_ArchiveByArchivedByView">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- Searchable archives view for efficient archive/search queries -->
				<bean class="jp.aegif.nemaki.patch.Patch_SearchableArchivesView">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- Archives by archivedAt view for DB-level chronological pagination -->
				<bean class="jp.aegif.nemaki.patch.Patch_ArchivesByArchivedAtView">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- Cloud Drive Metadata secondary type for Google Drive / OneDrive integration -->
				<bean class="jp.aegif.nemaki.patch.Patch_CloudDriveMetadataSecondaryType">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- External Integration secondary type for external context data (cloud sync, CRM, ERP, chat) -->
				<bean class="jp.aegif.nemaki.patch.Patch_ExternalIntegrationSecondaryType">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- External Integration source fields (sourceArchetype, sourceSystem, sourceObjectId, etc.) -->
				<bean class="jp.aegif.nemaki.patch.Patch_ExternalIntegrationSourceFields">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- Business record metadata secondary type (CRM/ERP/BPM) -->
				<bean class="jp.aegif.nemaki.patch.Patch_BusinessRecordMetadataSecondaryType">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- Chat context metadata secondary type (Slack/Teams) -->
				<bean class="jp.aegif.nemaki.patch.Patch_ChatContextMetadataSecondaryType">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- Note metadata secondary type for compound note page properties -->
				<bean class="jp.aegif.nemaki.patch.Patch_NoteMetadataSecondaryType">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- Message metadata secondary type for email envelope properties -->
				<bean class="jp.aegif.nemaki.patch.Patch_MessageMetadataSecondaryType">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- Default cloud drive connector/profile definitions -->
				<bean class="jp.aegif.nemaki.patch.Patch_DefaultCloudDriveConnectorProfile">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- Semantic relationship subtypes for external ingestion -->
				<bean class="jp.aegif.nemaki.patch.Patch_IngestRelationshipTypes">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- CMIS 1.1 Retention Management secondary type (cmis:rm_clientMgtRetention) -->
				<bean class="jp.aegif.nemaki.patch.Patch_RetentionSecondaryTypes">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- CouchDB view for querying documents by expiration date -->
				<bean class="jp.aegif.nemaki.patch.Patch_RetentionExpirationView">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- RSS Token views for token persistence -->
				<bean class="jp.aegif.nemaki.patch.Patch_RssTokenViews">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- WebAuthn credential views for passkey support -->
				<bean class="jp.aegif.nemaki.patch.Patch_WebAuthnCredentialViews">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- CouchDB view for querying documents by lastModificationDate (localArchiveAfterDays) -->
				<bean class="jp.aegif.nemaki.patch.Patch_RetentionLastModificationView">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- RC4 (R2): Mango compound indexes for nemaki_conf _find paths
				     (ConnectorDefinition / ImportProfileDefinition / IngestJobRecord) -->
				<bean class="jp.aegif.nemaki.patch.Patch_IngestMangoIndexes">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- (type) Mango index on each content DB so getApiKeys resolves
				     {type:apiKey} via _find without a full collection scan. -->
				<bean class="jp.aegif.nemaki.patch.Patch_ApiKeyMangoIndex">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
				<!-- Mango compound indexes for the search-index ACL reconciliation
				     queue (searchIndexAclReindexTask) in nemaki_conf. -->
				<bean class="jp.aegif.nemaki.patch.Patch_SearchIndexReconcileMangoIndex">
					<property name="patchUtil">
						<ref bean="patchUtil" />
					</property>
				</bean>
			</list>
		</property>
	</bean>

	<bean id="patchUtil" class="jp.aegif.nemaki.patch.PatchUtil">
		<property name="propertyManager">
			<ref bean="propertyManager" />
		</property>
		<property name="repositoryInfoMap">
			<ref bean="repositoryInfoMap" />
		</property>
		<property name="contentDaoService">
