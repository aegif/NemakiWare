    <bean id="springContext" class="jp.aegif.nemaki.util.spring.SpringContext" />
    
    <!-- CORS filter bean — exposed to servlet container via DelegatingFilterProxy in web.xml -->
    <bean id="simpleCorsFilter" class="jp.aegif.nemaki.rest.SimpleCorsFilter" init-method="resolveOrigins">
        <property name="propertyManager" ref="propertyManager" />
    </bean>

    <!-- AuthenticationFilter bean definition with explicit dependencies -->
    <bean id="restAuthenticationFilter" class="jp.aegif.nemaki.rest.AuthenticationFilter">
        <property name="propertyManager" ref="propertyManager" />
        <property name="authenticationService" ref="AuthenticationService" />
        <property name="tokenService" ref="TokenService" />
        <property name="repositoryInfoMap" ref="repositoryInfoMap" />
        <property name="principalService" ref="PrincipalService" />
    </bean>

    <bean id="repositoriesLegacyResource" class="jp.aegif.nemaki.rest.RepositoriesLegacyResource">
        <property name="repositoryInfoMap">
            <ref bean="repositoryInfoMap" />
        </property>
    </bean>

    <!-- Integration Settings Service -->
    <bean id="integrationSettingsService" class="jp.aegif.nemaki.rest.controller.IntegrationSettingsService">
        <property name="propertyManager" ref="propertyManager" />
        <property name="connectorPool" ref="connectorPool" />
        <property name="nemakiCachePool" ref="nemakiCachePool" />
        <property name="repositoryInfoMap" ref="repositoryInfoMap" />
    </bean>

    <!-- Catalog Property Mapping Resolver -->
    <bean id="catalogPropertyMappingResolver" class="jp.aegif.nemaki.rest.purview.payload.CatalogPropertyMappingResolver">
        <constructor-arg ref="integrationSettingsService" />
        <constructor-arg ref="TypeService" />
        <constructor-arg ref="repositoryInfoMap" />
    </bean>

    <!-- External Ingestion Services -->
    <bean id="connectorDefinitionService" class="jp.aegif.nemaki.rest.ingest.ConnectorDefinitionServiceImpl">
        <property name="connectorPool" ref="connectorPool" />
    </bean>
    <bean id="importProfileDefinitionService" class="jp.aegif.nemaki.rest.ingest.ImportProfileDefinitionServiceImpl">
        <property name="connectorPool" ref="connectorPool" />
        <property name="connectorDefinitionService" ref="connectorDefinitionService" />
    </bean>
    <bean id="ingestAuthorizationService" class="jp.aegif.nemaki.rest.ingest.IngestAuthorizationService">
        <property name="contentService" ref="ContentService" />
        <property name="principalService" ref="PrincipalService" />
    </bean>
    <bean id="ingestLineageEmitter" class="jp.aegif.nemaki.rest.ingest.IngestLineageEmitter" />
    <bean id="ingestMetadataService" class="jp.aegif.nemaki.rest.ingest.IngestMetadataService">
        <property name="contentService" ref="ContentService" />
        <property name="nemakiCachePool" ref="nemakiCachePool" />
    </bean>
    <bean id="canonicalImportService" class="jp.aegif.nemaki.rest.ingest.CanonicalImportServiceImpl">
        <property name="connectorDefinitionService" ref="connectorDefinitionService" />
        <property name="importProfileDefinitionService" ref="importProfileDefinitionService" />
        <property name="contentService" ref="ContentService" />
        <property name="contentDaoService" ref="ContentDaoService" />
        <property name="objectService" ref="objectService" />
        <property name="versioningService" ref="VersioningService" />
        <property name="nemakiCachePool" ref="nemakiCachePool" />
        <property name="ingestJobService" ref="ingestJobService" />
        <property name="relationshipService" ref="RelationshipService" />
        <property name="integrationSettingsService" ref="integrationSettingsService" />
        <property name="auditLogger" ref="auditLogger" />
        <property name="ingestMetadataService" ref="ingestMetadataService" />
        <property name="ingestLineageEmitter" ref="ingestLineageEmitter" />
    </bean>

    <bean id="ingestJobService" class="jp.aegif.nemaki.rest.ingest.IngestJobService">
        <property name="connectorPool" ref="connectorPool" />
    </bean>
    <bean id="fetchSupport" class="jp.aegif.nemaki.rest.ingest.FetchSupport">
        <property name="propertyManager" ref="propertyManager" />
        <property name="ingestJobService" ref="ingestJobService" />
        <property name="canonicalImportService" ref="canonicalImportService" />
    </bean>
    <bean id="checkpointManager" class="jp.aegif.nemaki.rest.ingest.CheckpointManager">
        <property name="settingsService" ref="integrationSettingsService" />
        <property name="profileService" ref="importProfileDefinitionService" />
    </bean>
    <!-- Fetch Orchestrators (11 adapters) -->
    <bean id="boxOrchestrator" class="jp.aegif.nemaki.rest.ingest.fileshare.BoxFetchOrchestrator">
        <property name="fetchSupport" ref="fetchSupport" />
        <property name="checkpointManager" ref="checkpointManager" />
        <property name="canonicalImportService" ref="canonicalImportService" />
    </bean>
    <bean id="dropboxOrchestrator" class="jp.aegif.nemaki.rest.ingest.fileshare.DropboxFetchOrchestrator">
        <property name="fetchSupport" ref="fetchSupport" />
        <property name="checkpointManager" ref="checkpointManager" />
        <property name="canonicalImportService" ref="canonicalImportService" />
    </bean>
    <bean id="imapOrchestrator" class="jp.aegif.nemaki.rest.ingest.mail.ImapFetchOrchestrator">
        <property name="fetchSupport" ref="fetchSupport" />
        <property name="checkpointManager" ref="checkpointManager" />
        <property name="canonicalImportService" ref="canonicalImportService" />
    </bean>
    <bean id="gmailOrchestrator" class="jp.aegif.nemaki.rest.ingest.mail.GmailFetchOrchestrator">
        <property name="fetchSupport" ref="fetchSupport" />
        <property name="checkpointManager" ref="checkpointManager" />
        <property name="canonicalImportService" ref="canonicalImportService" />
    </bean>
    <bean id="m365MailOrchestrator" class="jp.aegif.nemaki.rest.ingest.mail.M365MailFetchOrchestrator">
        <property name="fetchSupport" ref="fetchSupport" />
        <property name="checkpointManager" ref="checkpointManager" />
        <property name="canonicalImportService" ref="canonicalImportService" />
    </bean>
    <bean id="slackOrchestrator" class="jp.aegif.nemaki.rest.ingest.chat.SlackFetchOrchestrator">
        <property name="fetchSupport" ref="fetchSupport" />
        <property name="checkpointManager" ref="checkpointManager" />
        <property name="canonicalImportService" ref="canonicalImportService" />
    </bean>
    <bean id="teamsOrchestrator" class="jp.aegif.nemaki.rest.ingest.chat.TeamsFetchOrchestrator">
        <property name="fetchSupport" ref="fetchSupport" />
        <property name="checkpointManager" ref="checkpointManager" />
        <property name="canonicalImportService" ref="canonicalImportService" />
    </bean>
    <bean id="mattermostOrchestrator" class="jp.aegif.nemaki.rest.ingest.chat.MattermostFetchOrchestrator">
        <property name="fetchSupport" ref="fetchSupport" />
        <property name="checkpointManager" ref="checkpointManager" />
        <property name="canonicalImportService" ref="canonicalImportService" />
    </bean>
    <bean id="chatworkOrchestrator" class="jp.aegif.nemaki.rest.ingest.chat.ChatworkFetchOrchestrator">
        <property name="fetchSupport" ref="fetchSupport" />
        <property name="checkpointManager" ref="checkpointManager" />
        <property name="canonicalImportService" ref="canonicalImportService" />
    </bean>
    <bean id="notionOrchestrator" class="jp.aegif.nemaki.rest.ingest.note.NotionFetchOrchestrator">
        <property name="fetchSupport" ref="fetchSupport" />
        <property name="checkpointManager" ref="checkpointManager" />
        <property name="canonicalImportService" ref="canonicalImportService" />
    </bean>
    <bean id="salesforceOrchestrator" class="jp.aegif.nemaki.rest.ingest.record.SalesforceFetchOrchestrator">
        <property name="fetchSupport" ref="fetchSupport" />
        <property name="checkpointManager" ref="checkpointManager" />
        <property name="canonicalImportService" ref="canonicalImportService" />
    </bean>
    <bean id="fetchOrchestratorRegistry" class="jp.aegif.nemaki.rest.ingest.FetchOrchestratorRegistry">
        <property name="orchestrators">
            <map>
                <entry key="box" value-ref="boxOrchestrator" />
                <entry key="dropbox" value-ref="dropboxOrchestrator" />
                <entry key="imap" value-ref="imapOrchestrator" />
                <entry key="gmail_mail" value-ref="gmailOrchestrator" />
                <entry key="m365_mail" value-ref="m365MailOrchestrator" />
                <entry key="slack" value-ref="slackOrchestrator" />
                <entry key="teams" value-ref="teamsOrchestrator" />
                <entry key="mattermost" value-ref="mattermostOrchestrator" />
                <entry key="chatwork" value-ref="chatworkOrchestrator" />
                <entry key="notion" value-ref="notionOrchestrator" />
                <entry key="salesforce" value-ref="salesforceOrchestrator" />
            </map>
        </property>
    </bean>
    <bean id="imapIdleMonitor" class="jp.aegif.nemaki.rest.ingest.mail.ImapIdleMonitor">
        <property name="profileService" ref="importProfileDefinitionService" />
        <property name="connectorService" ref="connectorDefinitionService" />
        <property name="fetchSupport" ref="fetchSupport" />
        <property name="canonicalImportService" ref="canonicalImportService" />
    </bean>
    <bean id="ingestSchedulerService" class="jp.aegif.nemaki.rest.ingest.IngestSchedulerService">
        <property name="profileService" ref="importProfileDefinitionService" />
        <property name="connectorService" ref="connectorDefinitionService" />
        <property name="canonicalImportService" ref="canonicalImportService" />
        <property name="settingsService" ref="integrationSettingsService" />
        <property name="propertyManager" ref="propertyManager" />
        <property name="repositoryInfoMap" ref="repositoryInfoMap" />
        <property name="ingestJobService" ref="ingestJobService" />
        <property name="cloudantClientPool" ref="connectorPool" />
        <property name="checkpointManager" ref="checkpointManager" />
        <property name="fetchSupport" ref="fetchSupport" />
        <property name="orchestratorRegistry" ref="fetchOrchestratorRegistry" />
        <property name="imapIdleMonitor" ref="imapIdleMonitor" />
        <!-- Multi-replica safety: only the leader replica polls. Component-
             scanned bean from jp.aegif.nemaki.rest.purview.journal. -->
        <property name="leaderElection" ref="leaderElection" />
    </bean>

    <!-- Password Policy Service -->
    <bean id="passwordPolicyService" class="jp.aegif.nemaki.util.PasswordPolicyService">
        <property name="propertyManager" ref="propertyManager" />
        <property name="connectorPool" ref="connectorPool" />
        <property name="nemakiCachePool" ref="nemakiCachePool" />
    </bean>

    <!-- REST API Resource Beans with explicit Spring DI -->
    <bean id="userItemResource" class="jp.aegif.nemaki.rest.UserItemResource">
        <property name="contentService" ref="ContentService" />
        <property name="propertyManager" ref="propertyManager" />
        <property name="passwordPolicyService" ref="passwordPolicyService" />
        <property name="userGroupSearchService" ref="UserGroupSearchService" />
    </bean>

    <bean id="groupItemResource" class="jp.aegif.nemaki.rest.GroupItemResource">
        <property name="contentService" ref="ContentService" />
        <property name="userGroupSearchService" ref="UserGroupSearchService" />
    </bean>

    <bean id="permissionResource" class="jp.aegif.nemaki.rest.PermissionResource">
        <property name="contentService" ref="ContentService" />
        <property name="aclService" ref="AclService" />
    </bean>

    <!-- Solr Index Maintenance Service -->
    <bean id="SolrIndexMaintenanceService" class="org.springframework.aop.framework.ProxyFactoryBean" scope="singleton">
        <property name="proxyInterfaces">
            <list>
                <value>jp.aegif.nemaki.businesslogic.SolrIndexMaintenanceService</value>
            </list>
        </property>
        <property name="target">
            <ref bean="solrIndexMaintenanceService" />
        </property>
    </bean>
    <bean id="solrIndexMaintenanceService" class="jp.aegif.nemaki.businesslogic.impl.SolrIndexMaintenanceServiceImpl">
        <property name="contentService" ref="ContentService" />
        <property name="solrUtil" ref="solrUtil" />
        <property name="repositoryInfoMap" ref="repositoryInfoMap" />
    </bean>

    <!-- User/Group Search Service (Solr-based with CouchDB fallback) -->
    <bean id="UserGroupSearchService" class="org.springframework.aop.framework.ProxyFactoryBean" scope="singleton">
        <property name="proxyInterfaces">
            <list><value>jp.aegif.nemaki.businesslogic.UserGroupSearchService</value></list>
        </property>
        <property name="target"><ref bean="userGroupSearchServiceImpl" /></property>
    </bean>
    <bean id="userGroupSearchServiceImpl" class="jp.aegif.nemaki.businesslogic.impl.UserGroupSearchServiceImpl">
        <property name="contentService" ref="ContentService" />
        <property name="solrIndexMaintenanceService" ref="SolrIndexMaintenanceService" />
        <property name="propertyManager" ref="propertyManager" />
    </bean>

    <bean id="solrResource" class="jp.aegif.nemaki.rest.SolrResource">
        <property name="solrUtil" ref="solrUtil" />
        <property name="solrIndexMaintenanceService" ref="SolrIndexMaintenanceService" />
    </bean>

    <!-- Auth Config Resource - Public endpoint for SSO button visibility settings -->
    <bean id="authConfigResource" class="jp.aegif.nemaki.rest.AuthConfigResource">
        <property name="propertyManager" ref="propertyManager" />
    </bean>

    <!-- Directory Sync Service -->
    <bean id="DirectorySyncService" class="org.springframework.aop.framework.ProxyFactoryBean" scope="singleton">
        <property name="proxyInterfaces">
            <list>
                <value>jp.aegif.nemaki.sync.service.DirectorySyncService</value>
            </list>
        </property>
        <property name="target">
            <ref bean="directorySyncService" />
        </property>
    </bean>
    <bean id="directorySyncService" class="jp.aegif.nemaki.sync.service.DirectorySyncServiceImpl">
        <property name="contentService" ref="ContentService" />
        <property name="propertyManager" ref="propertyManager" />
    </bean>

    <bean id="directorySyncResource" class="jp.aegif.nemaki.rest.DirectorySyncResource">
        <property name="directorySyncService" ref="DirectorySyncService" />
    </bean>

    <!-- Directory Sync Scheduler -->
    <bean id="directorySyncScheduler" class="jp.aegif.nemaki.sync.scheduler.DirectorySyncScheduler"
          init-method="init" destroy-method="destroy" depends-on="DirectorySyncService,repositoryInfoMap">
        <property name="directorySyncService" ref="DirectorySyncService" />
        <property name="propertyManager" ref="propertyManager" />
        <property name="repositoryInfoMap" ref="repositoryInfoMap" />
    </bean>

    <!-- Cloud Directory Sync Service -->
    <bean id="cloudDirectorySyncService" class="jp.aegif.nemaki.sync.service.CloudDirectorySyncServiceImpl">
        <property name="principalService" ref="PrincipalService" />
        <property name="contentService" ref="contentService" />
        <property name="propertyManager" ref="propertyManager" />
    </bean>

    <!-- Cloud Directory Sync Scheduler -->
    <bean id="cloudDirectorySyncScheduler" class="jp.aegif.nemaki.sync.scheduler.CloudDirectorySyncScheduler"
          init-method="init" destroy-method="destroy">
        <property name="cloudDirectorySyncService" ref="cloudDirectorySyncService" />
        <property name="propertyManager" ref="propertyManager" />
        <!-- Multi-replica safety: defer to LeaderElection. -->
        <property name="leaderElection" ref="leaderElection" />
    </bean>

    <!-- Cloud Directory Sync REST API -->
    <bean id="cloudDirectorySyncResource" class="jp.aegif.nemaki.rest.CloudDirectorySyncResource">
        <property name="cloudDirectorySyncService" ref="cloudDirectorySyncService" />
    </bean>

    <!-- Cloud Drive Service -->
    <bean id="cloudDriveService" class="jp.aegif.nemaki.businesslogic.impl.CloudDriveServiceImpl">
        <property name="objectService" ref="objectService" />
    </bean>

    <bean id="cloudDriveResource" class="jp.aegif.nemaki.rest.CloudDriveResource">
        <property name="cloudDriveService" ref="cloudDriveService" />
        <property name="contentService" ref="ContentService" />
    </bean>

    <!-- Webhook Service and related beans -->
    <bean id="WebhookDaoService" class="org.springframework.aop.framework.ProxyFactoryBean" scope="singleton">
        <property name="proxyInterfaces">
            <list>
                <value>jp.aegif.nemaki.dao.WebhookDaoService</value>
            </list>
        </property>
        <property name="target">
            <ref bean="webhookDaoService" />
        </property>
    </bean>
    <bean id="webhookDaoService" class="jp.aegif.nemaki.dao.impl.couch.WebhookDaoServiceImpl">
        <property name="connectorPool" ref="connectorPool" />
    </bean>

    <bean id="webhookDispatcher" class="jp.aegif.nemaki.webhook.HttpWebhookDispatcher" />

    <bean id="WebhookService" class="org.springframework.aop.framework.ProxyFactoryBean" scope="singleton">
        <property name="proxyInterfaces">
            <list>
                <value>jp.aegif.nemaki.businesslogic.WebhookService</value>
            </list>
        </property>
        <property name="target">
            <ref bean="webhookService" />
        </property>
    </bean>
    <bean id="webhookService" class="jp.aegif.nemaki.businesslogic.impl.WebhookServiceImpl">
        <property name="contentService" ref="ContentService" />
        <property name="dispatcher" ref="webhookDispatcher" />
        <property name="webhookDaoService" ref="WebhookDaoService" />
        <property name="contentDaoService" ref="ContentDaoService" />
    </bean>

    <bean id="webhookResource" class="jp.aegif.nemaki.rest.WebhookResource">
        <property name="webhookService" ref="WebhookService" />
        <property name="contentService" ref="ContentService" />
    </bean>

    <!-- Long-term Storage Adapter Factory -->
    <bean id="longTermStorageAdapterFactory" class="jp.aegif.nemaki.archive.LongTermStorageAdapterFactory"
          init-method="init">
        <property name="propertyManager" ref="propertyManager" />
    </bean>

    <!-- Retention Migration Log DAO -->
    <bean id="retentionLogDaoService" class="jp.aegif.nemaki.dao.impl.couch.RetentionLogDaoServiceImpl">
        <property name="connectorPool" ref="connectorPool" />
    </bean>

    <!-- Retention Scheduler -->
    <bean id="retentionScheduler" class="jp.aegif.nemaki.archive.RetentionScheduler"
          init-method="init" destroy-method="destroy"
          depends-on="ContentService,repositoryInfoMap,longTermStorageAdapterFactory">
        <property name="contentService" ref="ContentService" />
        <property name="propertyManager" ref="propertyManager" />
        <property name="repositoryInfoMap" ref="repositoryInfoMap" />
        <property name="longTermStorageAdapterFactory" ref="longTermStorageAdapterFactory" />
        <property name="retentionLogDaoService" ref="retentionLogDaoService" />
        <property name="threadLockService" ref="threadLockService" />
        <property name="nemakiCachePool" ref="nemakiCachePool" />
        <!-- Multi-replica safety: defer to LeaderElection. -->
        <property name="leaderElection" ref="leaderElection" />
    </bean>

    <!-- Archive Search Resource -->
    <bean id="archiveSearchResource" class="jp.aegif.nemaki.rest.ArchiveSearchResource">
        <property name="contentService" ref="ContentService" />
    </bean>

    <!-- Archive Download Resource -->
    <bean id="archiveDownloadResource" class="jp.aegif.nemaki.rest.ArchiveDownloadResource">
        <property name="contentService" ref="ContentService" />
        <property name="longTermStorageAdapterFactory" ref="longTermStorageAdapterFactory" />
    </bean>

    <!-- API v1 Component Scanning -->
    <!-- Enable component scanning for OpenAPI v1 resources and filters -->
    <!-- This allows @Autowired dependencies to be injected via Jersey-Spring bridge -->
    <context:component-scan base-package="jp.aegif.nemaki.api.v1.filter" />
    <context:component-scan base-package="jp.aegif.nemaki.api.v1.resource" />

    <!-- Purview component scanning: must be in serviceContext.xml (post-refresh) -->
    <!-- so that ContentDaoService, ContentService, and CloudantClientPool are available -->
    <context:component-scan base-package="jp.aegif.nemaki.rest.purview" />

</beans>
