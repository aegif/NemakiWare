<configuration>
	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder class="net.logstash.logback.encoder.LogstashEncoder">
			<fieldNames>
				<version>[ignore]</version>
    			<logger>[ignore]</logger>
    			<levelValue>[ignore]</levelValue>
		   </fieldNames>
		   <includeContext>false</includeContext>
		</encoder>
	</appender>

	<property name="LOG_FILE" value="${catalina.home}/logs/nemakicore.log" />
	<appender name="FILE"
		class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_FILE}</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${LOG_FILE}.%d.gz</fileNamePattern>
			<maxHistory>14</maxHistory>
		</rollingPolicy>
		<encoder class="net.logstash.logback.encoder.LogstashEncoder">
			<fieldNames>
    			<logger>[ignore]</logger>
    			<levelValue>[ignore]</levelValue>
		   </fieldNames>
		   <includeContext>false</includeContext>
		</encoder>
	</appender>

	<!-- Lineage Dead-Letter Appender (events that failed to persist/publish) -->
	<property name="LINEAGE_DLQ_FILE" value="${catalina.home}/logs/lineage-dead-letter.log" />
	<appender name="LINEAGE_DLQ"
		class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LINEAGE_DLQ_FILE}</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${LINEAGE_DLQ_FILE}.%d{yyyy-MM-dd}.gz</fileNamePattern>
			<maxHistory>90</maxHistory>
			<totalSizeCap>1GB</totalSizeCap>
		</rollingPolicy>
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>%d{ISO8601} %msg%n</pattern>
		</encoder>
	</appender>

	<!-- Lineage Dead-Letter Logger (separate from application logs) -->
	<logger name="LINEAGE_DEAD_LETTER" level="ERROR" additivity="false">
		<appender-ref ref="LINEAGE_DLQ" />
	</logger>

	<root level="WARN">
		<appender-ref ref="FILE" />
	</root>
	<!-- NemakiWare Application -->
	<logger name="jp.aegif.nemaki" level="INFO" additivity="false">
		<appender-ref ref="FILE" />
		<appender-ref ref="STDOUT" />
	</logger>
</configuration>