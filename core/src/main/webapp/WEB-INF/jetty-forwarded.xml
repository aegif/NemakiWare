<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "https://jetty.org/configure_12.dtd">
<!--
  Jetty 12 server configuration with HTTP connector and
  ForwardedRequestCustomizer.

  ForwardedRequestCustomizer is the Jetty equivalent of Tomcat's
  RemoteIpValve.  It rewrites request.getScheme(), getServerName(),
  and getServerPort() based on the X-Forwarded-* headers sent by a
  trusted proxy, so that servlet API values match the public-facing
  origin.  This matches the trust model used by ResourceBase
  (CSRF origin check) and AuthTokenResource (cookie Secure flag).
-->
<Configure id="Server" class="org.eclipse.jetty.server.Server">

  <!-- HttpConfiguration with ForwardedRequestCustomizer -->
  <New id="httpConfig" class="org.eclipse.jetty.server.HttpConfiguration">
    <Set name="secureScheme">https</Set>
    <Set name="securePort">443</Set>
    <Set name="outputBufferSize">32768</Set>
    <Set name="requestHeaderSize">8192</Set>
    <Set name="responseHeaderSize">8192</Set>
    <Set name="sendServerVersion">false</Set>
    <Set name="sendDateHeader">false</Set>
    <Call name="addCustomizer">
      <Arg>
        <New class="org.eclipse.jetty.server.ForwardedRequestCustomizer">
          <Set name="forwardedHostHeader">X-Forwarded-Host</Set>
          <Set name="forwardedProtoHeader">X-Forwarded-Proto</Set>
          <Set name="forwardedForHeader">X-Forwarded-For</Set>
        </New>
      </Arg>
    </Call>
  </New>

  <!-- HTTP Connector -->
  <Call name="addConnector">
    <Arg>
      <New class="org.eclipse.jetty.server.ServerConnector">
        <Arg><Ref refid="Server" /></Arg>
        <Arg type="int">1</Arg>
        <Arg type="int">-1</Arg>
        <Arg>
          <Array type="org.eclipse.jetty.server.ConnectionFactory">
            <Item>
              <New class="org.eclipse.jetty.server.HttpConnectionFactory">
                <Arg><Ref refid="httpConfig" /></Arg>
              </New>
            </Item>
          </Array>
        </Arg>
        <Set name="port">8081</Set>
        <Set name="idleTimeout">30000</Set>
      </New>
    </Arg>
  </Call>

</Configure>
