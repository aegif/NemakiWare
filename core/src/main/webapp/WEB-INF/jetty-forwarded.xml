<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "https://jetty.org/configure_12.dtd">
<!--
  Jetty 12 server configuration for the dev server (mvn jetty:run).

  ForwardedRequestCustomizer is INTENTIONALLY NOT registered here.
  Reason: Jetty's ForwardedRequestCustomizer has no built-in
  trusted-proxy IP filter (unlike Tomcat's RemoteIpValve
  internalProxies), so adding it would let any client that can
  reach the Jetty port spoof X-Forwarded-Host and rewrite the
  servlet-facing scheme/host/port observed by ResourceBase and
  AuthTokenResource.  That defeats the CSRF origin check.

  Jetty dev is for local code-iteration only — it should never sit
  behind a production reverse proxy.  If you do need to test a
  reverse-proxy scenario, use the Tomcat Docker image (which has
  the hardened RemoteIpValve in docker/core/server.xml).

  This file is kept (rather than removed) so that the Jetty plugin
  has an external XML to drive the connector definition; previously
  the connector was defined inline in pom.xml as <httpConnector>,
  but moving it here keeps connector + (future) customizer config
  in one place and matches the trust-model documentation in
  docs/TESTING-ENVIRONMENTS.md.
-->
<Configure id="Server" class="org.eclipse.jetty.server.Server">

  <!-- HttpConfiguration WITHOUT ForwardedRequestCustomizer.
       Servlet values (getScheme/getServerName/getServerPort) reflect
       the actual local connection only. -->
  <New id="httpConfig" class="org.eclipse.jetty.server.HttpConfiguration">
    <Set name="secureScheme">https</Set>
    <Set name="securePort">443</Set>
    <Set name="outputBufferSize">32768</Set>
    <Set name="requestHeaderSize">8192</Set>
    <Set name="responseHeaderSize">8192</Set>
    <Set name="sendServerVersion">false</Set>
    <Set name="sendDateHeader">false</Set>
  </New>

  <!-- HTTP Connector on port 8081 -->
  <Call name="addConnector">
    <Arg>
      <New class="org.eclipse.jetty.server.ServerConnector">
        <Arg><Ref refid="Server" /></Arg>
        <Arg type="int">1</Arg>
        <Arg type="int">-1</Arg>
        <Arg>
          <Array type="org.eclipse.jetty.server.ConnectionFactory">
            <Item>
              <New class="org.eclipse.jetty.server.HttpConnectionFactory">
                <Arg><Ref refid="httpConfig" /></Arg>
              </New>
            </Item>
          </Array>
        </Arg>
        <Set name="port">8081</Set>
        <Set name="idleTimeout">30000</Set>
      </New>
    </Arg>
  </Call>

</Configure>
