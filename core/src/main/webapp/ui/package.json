    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "vite": "^7.2.2",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "js-yaml": "^4.2.0",
    "swagger-ui-react": {
      "react": "$react",
      "react-dom": "$react-dom",
      "dompurify": "3.4.12",
      "immutable": "^4.3.9"
    },
    "esbuild": "0.28.1"
