  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "SKIP_KEYCLOAK=true playwright test --project=chromium",
    "test:all": "playwright test --project=chromium",
    "test:standard": "SKIP_KEYCLOAK=true playwright test --project=chromium",
    "test:g5": "SKIP_KEYCLOAK=true playwright test tests/basic-connectivity.spec.ts tests/auth/login.spec.ts tests/documents/document-management.spec.ts tests/admin/initial-content-setup.spec.ts tests/api/webhook-api.spec.ts tests/api/session-management.spec.ts tests/components/layout-navigation.spec.ts --project=chromium --workers=1",
    "test:external-auth": "playwright test tests/auth/ldap-oidc-integration.spec.ts tests/auth/oidc-login.spec.ts tests/auth/saml-login.spec.ts --project=chromium",
    "test:unit": "vitest run",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "SKIP_KEYCLOAK=true playwright test --headed --project=chromium",
    "test:docker": "DOCKER_ENV=1 playwright test --reporter=list",
    "playwright:install": "playwright install",
    "playwright:install-deps": "playwright install-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@testing-library/jest-dom": "^6.9.1",
