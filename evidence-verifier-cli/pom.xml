<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>jp.aegif.nemakiware</groupId>
        <artifactId>nemakiware</artifactId>
        <version>3.4.0</version>
    </parent>
    <artifactId>evidence-verifier-cli</artifactId>
    <packaging>jar</packaging>
    <name>evidence-verifier-cli</name>

    <!--
      The command a receiving organisation runs. Depends on evidence-verifier-core and nothing
      else: an argument parser pulled in from somewhere would be a dependency shipped with a
      verifier, and every dependency is something a third party has to trust alongside it.
    -->
    <dependencies>
        <dependency>
            <groupId>jp.aegif.nemakiware</groupId>
            <artifactId>evidence-verifier-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>6.1.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
      The distribution is this jar plus target/lib/: the jar's manifest names the main class and
      the four jars beside it (evidence-verifier-core and BouncyCastle's bcpkix / bcprov /
      bcutil), so `java -jar evidence-verifier-cli-<version>.jar` runs from a directory holding
      both. NOT a shaded jar: BouncyCastle's jars are signed and published, and a receiving
      organisation checks them against Maven Central's checksums — repacked into one file they
      would have to trust this build's repacking instead (9-6 review, P1: the release notes
      documented `java -jar` and nothing built a jar that could be run that way).
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>jp.aegif.nemaki.verifier.cli.Verify</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>lib-beside-the-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
